/// Module "env" — process-like utilities.
/// Errors: 0 = ok, negative = error (see bindings/README.md).
interface env {
  /// Log a message without a trailing newline.
  print: func(message: string);

  /// Log a message with a trailing newline.
  println: func(message: string);

  /// Block the calling task.
  delay: func(milliseconds: s32);

  /// Milliseconds since boot (wraps every ~49 days). Tick source for GUI loops.
  millis: func() -> u32;

  /// Reboot the whole device. Does not return.
  reboot: func();

  /// AssemblyScript abort hook: logs and stops the app.
  abort: func(message: s32, file-name: s32, line: s32, column: s32);

  /// C strtod. end-ptr (guest address of a u32, or 0) receives the guest
  /// address of the first unparsed character.
  strtod: func(str: string, end-ptr: u32) -> f64;

  /// Look up a device environment variable (NVS config key "env",
  /// ';'-separated KEY=VALUE pairs). snprintf-style: returns the value
  /// length; the value + NUL is copied to buf when cap is large enough.
  /// -5 when the variable is not set.
  getenv: func(name: string, buf: u32, cap: u32) -> s32;
}
