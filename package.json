{
  "name": "wasm-os-monorepo",
  "version": "0.1.0",
  "description": "WebAssembly OS for ESP32 - run WASM modules on microcontrollers",
  "private": true,
  "workspaces": [
    "mklfs",
    "wasm-os-sdk",
    "wasm-os-cli",
    "wasm-os-tests"
  ],
  "scripts": {
    "test": "npm test --workspaces --if-present",
    "test:hw": "npm run test:hw --workspace wasm-os-tests",
    "test:wifi": "npm run test:wifi --workspace wasm-os-tests",
    "test:priority": "npm run test:priority --workspace wasm-os-tests",
    "test:supervisor": "npm run test:supervisor --workspace wasm-os-tests",
    "test:touch": "npm run test:touch --workspace wasm-os-tests",
    "test:touch:p4": "npm run test:touch:p4 --workspace wasm-os-tests",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "npm test && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0"
  }
}
