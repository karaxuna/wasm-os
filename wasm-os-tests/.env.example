# Copy to cli/tests/.env and fill in. The hardware tests push it to
# /littlefs/.env and reboot the device so the firmware picks it up.
#
# WIFI_SSID / WIFI_PASS / LOG_LEVEL are consumed by the firmware; every other
# key is handed to the WASM app as an environment variable.

WIFI_SSID=my-network
WIFI_PASS=secret
LOG_LEVEL=3
