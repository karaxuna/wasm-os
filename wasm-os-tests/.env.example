# Copy to wasm-os-tests/.env and fill in. The hardware tests push it to
# /littlefs/.env and reboot the device so the firmware picks it up.
#
# LOG_LEVEL is consumed by the firmware; every other key — including
# WIFI_SSID/WIFI_PASS — is handed to the WASM app as an environment variable
# (apps read them via getenv and pass them to wifi_connect).

WIFI_SSID=my-network
WIFI_PASS=secret
LOG_LEVEL=3
